# LiveKit project credentials. Keep real values out of source control.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OIDC access-token verification. Requests fail closed when these are missing.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_SIGNING_ALGORITHM=RS256

# Voice and avatar providers.
OPENAI_API_KEY=
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_SANDBOX=true
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Agent and session policy.
MIA_AGENT_NAME=mia
VOICE_SESSION_TTL_SECONDS=900
ALLOWED_ORIGINS=http://localhost:7357,http://127.0.0.1:7357