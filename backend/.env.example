# LiveKit project credentials. Keep real values out of source control.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OIDC access-token verification. Requests fail closed when these are missing.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_SIGNING_ALGORITHM=RS256

# Local development only (requests from 127.0.0.1, without OIDC).
# true is needed to use Mia on your own computer: it also lets the app call
# the server from any localhost port. Never enable on a deployed server.
ELOQIA_ENV=development
ELOQIA_ALLOW_LOCAL_AUTH=true

# OpenAI (understanding the learner during live sessions).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# Mia's chat brain (conversations, Ask Mia, role-plays, Writing Studio reviews).
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Per-learner limits to keep costs under control.
MIA_CHAT_MAX_PER_WINDOW=30
MIA_CHAT_WINDOW_SECONDS=600
MIA_CHAT_MAX_PER_DAY=200

# Cartesia (Mia's voice: live sessions and "Hear Mia" buttons).
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE_ID=b7d50908-b17c-442d-ad8d-810c63997ed9
CARTESIA_SECONDARY_VOICE_ID=
CARTESIA_LANGUAGE=en
CARTESIA_SPEED=1.0
CARTESIA_VOLUME=1.0
CARTESIA_API_VERSION=2026-08-14

# Avatar (future visual layer, not required for voice).
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_SANDBOX=true

# Agent and session policy.
MIA_AGENT_NAME=mia
VOICE_SESSION_TTL_SECONDS=900
# Flutter Web origins allowed to call this API (flutter run uses its own port).
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
